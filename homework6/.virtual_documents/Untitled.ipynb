import numpy as np


# 3.1 1D NumPy Arrays

list = [20, 27, 9, 12, 31, 17, 4, 50, 39, 35]
arr = np.array(list)

print(arr * 4)

print(np.mean(arr))

print(np.median(arr))

print(np.std(arr))

min_index = np.argmin(arr)
max_index = np.argmax(arr)

print(arr[min_index])
print(arr[max_index])

print(np.min(arr))
print(np.max(arr))
# Yes, they match the values from the previous step

mask = arr > 20
print(arr[mask])


